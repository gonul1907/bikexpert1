{%- assign vendors = collection.products | map: "vendor" | uniq | sort -%}

<div style="max-width:1280px; margin:0 auto; padding:2rem 1.25rem 4rem;">

  <!-- Header -->
  <div style="margin-bottom:1.5rem;">
    <p style="font-size:0.72rem; font-weight:700; letter-spacing:0.2em; text-transform:uppercase; color:#6b7280; margin:0 0 0.35rem;">Collectie</p>
    <h1 style="font-size:2rem; font-weight:900; letter-spacing:-0.04em; margin:0 0 0.4rem; color:#0a0a0a;">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
    <div style="color:#6b7280; max-width:40rem; font-size:0.9rem; margin:0 0 0.4rem;">{{ collection.description }}</div>
    {%- endif -%}
    <p style="font-size:0.85rem; color:#6b7280; margin:0;" id="bx-count">{{ collection.products_count }} producten</p>
  </div>

  {%- if collection.products.size > 0 -%}

  <!-- Mobile filter toggle -->
  <button id="bx-mob-toggle" onclick="bxMobToggle()" style="width:100%; background:#f7f7f7; border:1px solid #e5e5e5; border-radius:8px; padding:0.7rem 1rem; font-weight:700; font-size:0.85rem; color:#111; cursor:pointer; margin-bottom:0.75rem; align-items:center; justify-content:space-between; font-family:inherit; display:none;">
    <span style="display:flex; align-items:center; gap:0.5rem;">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
      Filters
    </span>
    <span id="bx-mob-badge" style="background:#b5f23d; color:#111; font-size:0.72rem; font-weight:800; padding:2px 8px; border-radius:20px; display:none;"></span>
  </button>

  <!-- Actieve filter chips -->
  <div id="bx-chips" style="display:flex; flex-wrap:wrap; gap:0.4rem; margin-bottom:0.75rem;"></div>

  <!-- Layout -->
  <div id="bx-layout" style="display:flex; gap:1.75rem; align-items:flex-start;">

    <!-- Filter sidebar -->
    <aside id="bx-sidebar" style="width:200px; flex-shrink:0; position:sticky; top:1.25rem;">

      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
        <span style="font-size:0.72rem; font-weight:800; text-transform:uppercase; letter-spacing:0.1em; color:#111;">Filters</span>
        <button onclick="bxClearAll()" style="font-size:0.75rem; color:#888; background:none; border:none; cursor:pointer; font-family:inherit; padding:0; text-decoration:underline;">Wis alles</button>
      </div>

      <!-- Beschikbaarheid -->
      <div style="margin-bottom:1.1rem; padding-bottom:1.1rem; border-bottom:1px solid #f0f0f0;">
        <p style="font-size:0.7rem; font-weight:800; text-transform:uppercase; letter-spacing:0.1em; color:#aaa; margin:0 0 0.55rem;">Beschikbaarheid</p>
        <button class="bxf" data-group="avail" data-value="in-stock" data-label="Op voorraad" onclick="bxToggle(this)" style="display:flex; align-items:center; gap:0.45rem; width:100%; text-align:left; background:none; border:none; padding:0.28rem 0; font-size:0.84rem; color:#444; cursor:pointer; font-family:inherit; font-weight:500;">
          <span class="bxf-dot" style="flex-shrink:0; width:13px; height:13px; border:2px solid #ccc; border-radius:3px; transition:all 0.15s;"></span>
          Op voorraad
        </button>
      </div>

      <!-- Merk -->
      {%- if vendors.size > 0 -%}
      <div style="margin-bottom:1.1rem; padding-bottom:1.1rem; border-bottom:1px solid #f0f0f0;">
        <p style="font-size:0.7rem; font-weight:800; text-transform:uppercase; letter-spacing:0.1em; color:#aaa; margin:0 0 0.55rem;">Merk</p>
        {%- for v in vendors -%}
        <button class="bxf" data-group="merk" data-value="{{ v | escape }}" data-label="{{ v | escape }}" onclick="bxToggle(this)" style="display:flex; align-items:center; gap:0.45rem; width:100%; text-align:left; background:none; border:none; padding:0.28rem 0; font-size:0.84rem; color:#444; cursor:pointer; font-family:inherit; font-weight:500;">
          <span class="bxf-dot" style="flex-shrink:0; width:13px; height:13px; border:2px solid #ccc; border-radius:3px; transition:all 0.15s;"></span>
          {{ v }}
        </button>
        {%- endfor -%}
      </div>
      {%- endif -%}

      <!-- Dynamische variant-optie filters worden hier ingevoegd door JS -->
      <div id="bx-dyn-filters"></div>

    </aside>

    <!-- Product grid -->
    <main style="flex:1; min-width:0;">
      <div id="bx-grid" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(190px, 1fr)); gap:1.1rem;">
        {%- for product in collection.products -%}
        <div class="bx-item"
          data-vendor="{{ product.vendor | escape }}"
          data-avail="{{ product.available }}"
          data-o1n="{{ product.options[0] | downcase | escape }}"
          data-o1v="|{{ product.variants | map: 'option1' | uniq | join: '|' | escape }}|"
          data-o2n="{{ product.options[1] | downcase | escape }}"
          data-o2v="|{{ product.variants | map: 'option2' | uniq | join: '|' | escape }}|"
          data-o3n="{{ product.options[2] | downcase | escape }}"
          data-o3v="|{{ product.variants | map: 'option3' | uniq | join: '|' | escape }}|">
          {%- render 'product-card', product: product -%}
        </div>
        {%- endfor -%}
      </div>
      <p id="bx-nores" style="display:none; padding:4rem 0; text-align:center; color:#6b7280; font-size:1rem;">
        Geen producten gevonden.
        <button onclick="bxClearAll()" style="background:none; border:none; color:#111; font-weight:700; cursor:pointer; font-family:inherit; text-decoration:underline;">Wis filters</button>
      </p>
    </main>

  </div>

  {%- if paginate.pages > 1 -%}
  <div style="margin-top:3rem; display:flex; justify-content:center; gap:0.5rem;">
    {{- paginate | default_pagination -}}
  </div>
  {%- endif -%}

  {%- else -%}
  <div style="padding:6rem 0; text-align:center;">
    <p style="font-size:1.1rem; color:#6b7280; margin:0 0 1.5rem;">Geen producten gevonden in deze collectie.</p>
    <a href="/collections/all" style="display:inline-flex; align-items:center; background:#0a0a0a; color:#fff; font-weight:700; padding:0.85rem 2rem; border-radius:30px; text-decoration:none;">Bekijk alle producten</a>
  </div>
  {%- endif -%}

</div>

<style>
  .bxf.active .bxf-dot { background:#b5f23d !important; border-color:#7bb820 !important; }
  .bxf.active { color:#111 !important; font-weight:700 !important; }
  @media (max-width:767px) {
    #bx-mob-toggle { display:flex !important; }
    #bx-layout { flex-direction:column !important; }
    #bx-sidebar { position:static !important; width:100% !important; background:#f9f9f9; border:1px solid #eee; border-radius:10px; padding:1rem 1.1rem; display:none; }
    #bx-sidebar.bx-open { display:block !important; }
    #bx-grid { grid-template-columns:repeat(2,1fr) !important; gap:0.75rem !important; }
  }
</style>

<script>
var bxSel = {};

// Bouw dynamische filters vanuit variant-opties
document.addEventListener('DOMContentLoaded', function() {
  var items = document.querySelectorAll('.bx-item');
  var groups = {}; // { optionName: Set<value> }
  var groupOrder = [];

  items.forEach(function(item) {
    for (var i = 1; i <= 3; i++) {
      var name = (item.getAttribute('data-o' + i + 'n') || '').trim();
      var vals = (item.getAttribute('data-o' + i + 'v') || '');
      if (!name || name === 'title') continue;
      if (!groups[name]) { groups[name] = new Set(); groupOrder.push(name); }
      vals.split('|').forEach(function(v) {
        v = v.trim();
        if (v) groups[name].add(v);
      });
    }
  });

  var container = document.getElementById('bx-dyn-filters');
  if (!container) return;

  // Verwijder duplicaten in groupOrder
  groupOrder = groupOrder.filter(function(v, i, a) { return a.indexOf(v) === i; });

  // Mooie labels
  var labels = { maat:'Maat', size:'Maat', kleur:'Kleur', color:'Kleur', geslacht:'Geslacht', type:'Type', gewicht:'Gewicht', wielmaat:'Wielmaat' };

  groupOrder.forEach(function(name) {
    var vals = Array.from(groups[name]).sort(function(a, b) {
      return a.localeCompare(b, 'nl', { numeric: true });
    });
    if (vals.length === 0) return;

    var label = labels[name] || (name.charAt(0).toUpperCase() + name.slice(1));
    var div = document.createElement('div');
    div.style.cssText = 'margin-bottom:1.1rem; padding-bottom:1.1rem; border-bottom:1px solid #f0f0f0;';

    var html = '<p style="font-size:0.7rem; font-weight:800; text-transform:uppercase; letter-spacing:0.1em; color:#aaa; margin:0 0 0.55rem;">' + label + '</p>';
    vals.forEach(function(val) {
      var esc = val.replace(/"/g, '&quot;');
      html += '<button class="bxf" data-group="opt_' + name + '" data-value="' + esc + '" data-label="' + esc + '" onclick="bxToggle(this)" style="display:flex; align-items:center; gap:0.45rem; width:100%; text-align:left; background:none; border:none; padding:0.28rem 0; font-size:0.84rem; color:#444; cursor:pointer; font-family:inherit; font-weight:500;"><span class="bxf-dot" style="flex-shrink:0; width:13px; height:13px; border:2px solid #ccc; border-radius:3px; transition:all 0.15s;"></span>' + val + '</button>';
    });
    div.innerHTML = html;
    container.appendChild(div);
  });
});

function bxToggle(btn) {
  var g = btn.getAttribute('data-group');
  var v = btn.getAttribute('data-value');
  if (!bxSel[g]) bxSel[g] = new Set();
  if (bxSel[g].has(v)) { bxSel[g].delete(v); btn.classList.remove('active'); }
  else { bxSel[g].add(v); btn.classList.add('active'); }
  bxApply();
}

function bxApply() {
  var items = document.querySelectorAll('.bx-item');
  var visible = 0;

  items.forEach(function(item) {
    var vendor = item.getAttribute('data-vendor');
    var avail  = item.getAttribute('data-avail');
    var show   = true;

    // Beschikbaarheid
    if (bxSel['avail'] && bxSel['avail'].size > 0 && bxSel['avail'].has('in-stock')) {
      if (avail !== 'true') show = false;
    }

    // Merk (OR)
    if (show && bxSel['merk'] && bxSel['merk'].size > 0) {
      if (!bxSel['merk'].has(vendor)) show = false;
    }

    // Variant optie filters (AND tussen opties, OR binnen optie)
    if (show) {
      for (var g in bxSel) {
        if (g.indexOf('opt_') !== 0) continue;
        if (bxSel[g].size === 0) continue;
        var optName = g.replace('opt_', '');
        var matched = false;
        for (var i = 1; i <= 3; i++) {
          var iName = (item.getAttribute('data-o' + i + 'n') || '');
          var iVals = (item.getAttribute('data-o' + i + 'v') || '');
          if (iName === optName) {
            bxSel[g].forEach(function(sel) {
              if (iVals.indexOf('|' + sel + '|') >= 0) matched = true;
            });
          }
        }
        if (!matched) { show = false; break; }
      }
    }

    item.style.display = show ? '' : 'none';
    if (show) visible++;
  });

  var el = document.getElementById('bx-count');
  if (el) el.textContent = visible + ' producten';
  var nr = document.getElementById('bx-nores');
  if (nr) nr.style.display = visible === 0 ? 'block' : 'none';

  renderChips();

  var total = 0;
  for (var g in bxSel) total += bxSel[g].size;
  var badge = document.getElementById('bx-mob-badge');
  if (badge) { badge.textContent = total; badge.style.display = total > 0 ? 'inline' : 'none'; }
}

function renderChips() {
  var c = document.getElementById('bx-chips');
  if (!c) return;
  c.innerHTML = '';
  var total = 0;
  for (var g in bxSel) total += bxSel[g].size;
  if (total === 0) return;

  document.querySelectorAll('.bxf.active').forEach(function(btn) {
    var lbl = btn.getAttribute('data-label') || btn.textContent.trim();
    var chip = document.createElement('button');
    chip.style.cssText = 'display:inline-flex; align-items:center; gap:0.3rem; background:#111; color:#fff; border:none; border-radius:20px; padding:0.28rem 0.75rem; font-size:0.78rem; font-weight:600; cursor:pointer; font-family:inherit;';
    chip.innerHTML = lbl + ' <span style="font-size:1rem; line-height:1;">x</span>';
    var _btn = btn;
    chip.onclick = function() { _btn.click(); };
    c.appendChild(chip);
  });

  if (total > 1) {
    var clr = document.createElement('button');
    clr.style.cssText = 'display:inline-flex; align-items:center; background:none; color:#666; border:1px solid #ccc; border-radius:20px; padding:0.28rem 0.75rem; font-size:0.78rem; cursor:pointer; font-family:inherit;';
    clr.textContent = 'Wis alles';
    clr.onclick = bxClearAll;
    c.appendChild(clr);
  }
}

function bxClearAll() {
  bxSel = {};
  document.querySelectorAll('.bxf').forEach(function(b) { b.classList.remove('active'); });
  bxApply();
}

function bxMobToggle() {
  var sb = document.getElementById('bx-sidebar');
  if (sb) sb.classList.toggle('bx-open');
}
</script>
