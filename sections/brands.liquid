  <div style="position:relative; overflow:hidden;">
    <div class="bx-marquee" style="display:flex; gap:4rem; width:max-content; animation:bx-scroll 18s linear infinite;">
      <span style="font-size:1.3rem; font-weight:900; color:#555; white-space:nowrap;">VOGUE</span>
      <span style="font-size:1.3rem; font-weight:900; color:#555; white-space:nowrap;">VOLARE</span>
      <span style="font-size:1.3rem; font-weight:900; color:#555; white-space:nowrap;">VICTORIA</span>
      <span style="font-size:1.3rem; font-weight:900; color:#555; white-space:nowrap;">CONWAY</span>
      <span style="font-size:1.3rem; font-weight:900; color:#555; white-space:nowrap;">POINTER</span>
      <span style="font-size:1.3rem; font-weight:900; color:#555; white-space:nowrap;">OUXI</span>
      <span style="font-size:1.3rem; font-weight:900; color:#555; white-space:nowrap;">ENGWE</span>
      <span style="font-size:1.3rem; font-weight:900; color:#555; white-space:nowrap;">WINDGOO</span>
      <span style="font-size:1.3rem; font-weight:900; color:#555; white-space:nowrap;">V20</span>
      <span style="font-size:1.3rem; font-weight:900; color:#555; white-space:nowrap;">A-SPADZ</span>
      <span style="font-size:1.3rem; font-weight:900; color:#555; white-space:nowrap;">EB</span>
      <!-- duplicate voor naadloze loop -->
      <span style="font-size:1.3rem; font-weight:900; color:#555; white-space:nowrap;">VOGUE</span>
      <span style="font-size:1.3rem; font-weight:900; color:#555; white-space:nowrap;">VOLARE</span>
      <span style="font-size:1.3rem; font-weight:900; color:#555; white-space:nowrap;">VICTORIA</span>
